rules_version = '2';

// Role-based access control for Salmoncow.
//
// Roles live on the Firebase Auth custom claim `role` (set by the setUserRole
// callable; seeded as 'user' by the onUserCreate auth trigger). These rules
// read the claim directly via request.auth.token.role, never via get(), so
// role checks cost zero Firestore reads.
//
// Spec: .specs/archive/001-multi-user-rbac/spec.md §VI, §VII, §X.4
service cloud.firestore {
    match /databases/{database}/documents {

        function isSignedIn() {
            return request.auth != null;
        }

        function roleOf() {
            return request.auth.token.role;
        }

        function isOwner() {
            return isSignedIn() && roleOf() == 'owner';
        }

        function isAdmin() {
            return isSignedIn() && roleOf() == 'admin';
        }

        function isOwnerOrAdmin() {
            return isOwner() || isAdmin();
        }

        function isSelf(uid) {
            return isSignedIn() && request.auth.uid == uid;
        }

        // Top-level fields a client may write on its own profile. Everything
        // else on a user doc — role, roleChangedAt, lastSignInAt — is
        // server-authoritative, written only by the Admin SDK, which bypasses
        // these rules entirely.
        function clientWritableUserFields() {
            return ['uid', 'email', 'displayName', 'photoURL',
                    'createdAt', 'updatedAt', 'preferences'];
        }

        // onUserCreate seeds email/displayName/photoURL as null when the auth
        // provider omits them, so null must stay acceptable here — otherwise a
        // preference update on such a profile would be denied.
        function isOptionalString(data, field, maxLen) {
            return !(field in data)
                   || data[field] == null
                   || (data[field] is string && data[field].size() <= maxLen);
        }

        function isValidPreferences(prefs) {
            return prefs is map
                   && prefs.keys().hasOnly(['theme', 'emailNotifications'])
                   && (!('theme' in prefs)
                       || prefs.theme in ['light', 'dark', 'system'])
                   && (!('emailNotifications' in prefs)
                       || prefs.emailNotifications is bool);
        }

        function isValidUserPayload(data) {
            return isOptionalString(data, 'email', 320)
                   && isOptionalString(data, 'displayName', 255)
                   && isOptionalString(data, 'photoURL', 2048)
                   && (!('createdAt' in data) || data.createdAt is timestamp)
                   && (!('updatedAt' in data) || data.updatedAt is timestamp)
                   && (!('preferences' in data)
                       || isValidPreferences(data.preferences));
        }

        // users/{uid} — profile doc. Role is server-authoritative: the client
        // may never create with a role field nor change an existing role. The
        // field allowlist below is what stops a user from planting arbitrary
        // data (an XSS payload in photoURL, a spoofed email shown in the admin
        // table, or megabytes of junk) on their own document.
        match /users/{uid} {
            allow read: if isSelf(uid) || isOwnerOrAdmin();

            allow create: if isSelf(uid)
                          && request.resource.data.keys()
                                 .hasOnly(clientWritableUserFields())
                          && (!('uid' in request.resource.data)
                              || request.resource.data.uid == uid)
                          && isValidUserPayload(request.resource.data);

            // affectedKeys() constrains only what changed, so server-written
            // fields already present on the doc need not be re-listed.
            allow update: if isSelf(uid)
                          && request.resource.data.diff(resource.data)
                                 .affectedKeys()
                                 .hasOnly(clientWritableUserFields())
                          && request.resource.data.role == resource.data.role
                          && request.resource.data.uid == resource.data.uid
                          && isValidUserPayload(request.resource.data);

            allow delete: if false;
        }

        // content/{id} — placeholder collection for the content management
        // feature. Any signed-in user can read; only owner/admin can write.
        //
        // Deliberately unvalidated: no code reads or writes this collection
        // yet, so there is no schema to enforce. Inventing one now would be
        // premature. Add field constraints alongside the first real writer.
        match /content/{id} {
            allow read: if isSignedIn();
            allow write: if isOwnerOrAdmin();
        }

        // audit/{autoId} — append-only role-change audit trail. Owner-only
        // read; Admin SDK (Cloud Function) is the sole writer.
        match /audit/{id} {
            allow read: if isOwner();
            allow write: if false;
        }

        // rateLimits/{action}/actors/{actorUid} — Cloud Function rate-limit
        // counters. Owner can read for visibility; only Admin SDK writes.
        match /rateLimits/{action}/actors/{actorUid} {
            allow read: if isOwner();
            allow write: if false;
        }
    }
}
