{
  "tabWidth": 4,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": ["*.yml", "*.yaml", "*.json"], "options": { "tabWidth": 2 } },
    { "files": ["*.md"], "options": { "tabWidth": 2, "proseWrap": "preserve" } }
  ]
}
